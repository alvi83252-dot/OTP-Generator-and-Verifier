# Optional. Used only to sign demo tokens and the lock cookie.
# Generate a long random string before a public Vercel deploy.
OTP_DEMO_SECRET=replace-with-a-long-random-string

# Leave these unset for the graded 30-second window and 60-second lockout.
# Set them only to rehearse the red lock without waiting the full minute.
# OTP_VALIDITY_SECONDS=30
# OTP_LOCKOUT_SECONDS=60
